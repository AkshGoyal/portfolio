---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Site',
    links: [
      { label: 'Experience', href: '/#experience' },
      { label: 'How I build', href: '/#approach' },
      { label: 'Projects', href: '/#projects' },
      { label: 'About', href: '/about/' },
    ],
  },
  {
    heading: 'Work',
    links: [
      { label: 'HCP Persona Chatbot', href: '/work/hcp-persona-chatbot/' },
      { label: 'Job Search Assistant', href: '/work/agent-job-applications/' },
      { label: 'Plan My Day', href: '/work/plan-my-day/' },
      { label: 'Resume (PDF)', href: '/resume.pdf' },
    ],
  },
  {
    heading: 'Elsewhere',
    links: [
      { label: 'Email', href: 'mailto:aksh.iitdelhi@gmail.com' },
      { label: 'GitHub', href: 'https://github.com/akshgoyal' },
      { label: 'LinkedIn', href: 'https://linkedin.com/in/akshgoyal' },
    ],
  },
];
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-3xl px-6 py-12 sm:px-8">
    <div class="grid gap-8 sm:grid-cols-3">
      {
        columns.map((column) => (
          <div>
            <h2 class="font-display text-[0.8125rem] font-semibold tracking-tight text-ink">
              {column.heading}
            </h2>
            <ul class="mt-3 space-y-2 font-mono text-[0.75rem]">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-muted underline-offset-4 transition-colors hover:text-accent hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-line pt-6 font-mono text-[0.75rem] text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <span>&copy; {year} Aksh Goyal</span>
      <span>Open to AI Engineer, FDE and AI Product roles</span>
    </div>
  </div>
</footer>
