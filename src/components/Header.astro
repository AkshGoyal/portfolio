---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/resume.pdf', label: 'Resume' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="border-b border-line">
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-6 px-6 py-5 sm:px-8"
  >
    <a
      href="/"
      class="font-display text-[0.95rem] font-semibold tracking-tight text-ink transition-colors hover:text-accent"
      >Aksh Goyal</a
    >
    <nav class="flex items-center gap-5 font-mono text-[0.8125rem]">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-muted underline-offset-4 transition-colors hover:text-accent hover:underline"
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
