---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/resume.pdf', label: 'Resume' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="border-b border-line">
  <div
    class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-5 sm:px-8"
  >
    <a
      href="/"
      class="font-display text-[0.95rem] font-semibold tracking-tight text-ink transition-colors hover:text-accent"
      >Aksh Goyal</a
    >
    <nav
      class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[0.8125rem] sm:gap-x-5"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-muted underline-offset-4 transition-colors hover:text-accent hover:underline"
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
