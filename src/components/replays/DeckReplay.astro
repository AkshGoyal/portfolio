---
interface Props {
  slides?: string[];
  title?: string;
  pdf?: string;
}
const { slides = [], title = 'Deck', pdf } = Astro.props;
---

<div class="replay deck" data-replay="deck">
  <div class="replay__bar">
    <span class="replay__caption">Flip through the deck</span>
    <div class="replay__controls">
      <button class="chip" type="button" data-deck-prev aria-label="Previous slide">Previous</button>
      <span class="deck__count" aria-live="polite"><b data-deck-at>1</b> of {slides.length}</span>
      <button class="chip" type="button" data-deck-next aria-label="Next slide">Next</button>
    </div>
  </div>
  <div class="deck__frame">
    {slides.map((src, i) => (
      <img src={src} alt={`${title}, slide ${i + 1}`} loading="lazy" decoding="async" data-deck-slide={i} hidden={i !== 0} />
    ))}
  </div>
  <div class="deck__dots" role="group" aria-label="Choose a slide">
    {slides.map((_, i) => <button type="button" data-deck-dot={i} aria-label={`Slide ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} />)}
  </div>
  {pdf && <p class="replay__note">A preview of {slides.length} slides. <a class="textlink" href={pdf}>Download the full deck (PDF)</a></p>}
</div>

<style>
  .deck__count {
    font-size: 0.85rem;
    color: var(--color-muted);
    align-self: center;
    padding: 0 6px;
  }
  .deck__frame {
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: #fff;
  }
  .deck__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .deck__dots {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin-top: 10px;
  }
  .deck__dots button {
    width: 28px;
    height: 6px;
    border-radius: 3px;
    border: 0;
    background: var(--color-line);
    cursor: pointer;
    padding: 0;
  }
  .deck__dots button[aria-pressed='true'] {
    background: var(--color-trace);
  }
</style>

<script>
  function initDecks() {
    document.querySelectorAll<HTMLElement>('[data-replay="deck"]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const slides = root.querySelectorAll<HTMLImageElement>('[data-deck-slide]');
      const dots = root.querySelectorAll<HTMLButtonElement>('[data-deck-dot]');
      const at = root.querySelector<HTMLElement>('[data-deck-at]')!;
      let i = 0;
      const go = (n: number) => {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, j) => (s.hidden = j !== i));
        dots.forEach((d, j) => d.setAttribute('aria-pressed', String(j === i)));
        at.textContent = String(i + 1);
      };
      root.querySelector('[data-deck-prev]')!.addEventListener('click', () => go(i - 1));
      root.querySelector('[data-deck-next]')!.addEventListener('click', () => go(i + 1));
      dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
      root.querySelector('.deck__frame')!.addEventListener('click', () => go(i + 1));
    });
  }
  initDecks();
  document.addEventListener('astro:after-swap', initDecks);
</script>
