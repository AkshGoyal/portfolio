---
// From the harness README: only chunk size varies, everything else fixed.
const sizes = ['1k', '2k', '4k', '8k'];
const series = {
  'recall@1': [21, 26, 42, 32],
  'recall@5': [47, 53, 63, 84],
  'recall@10': [53, 58, 84, 89],
};
const W = 560, H = 250, L = 44, R = 70, T = 14, B = 34;
const x = (i: number) => L + (i * (W - L - R)) / 3;
const y = (v: number) => T + (1 - v / 100) * (H - T - B);
---

<div class="replay evalr" data-replay="eval" data-k="recall@1">
  <div class="replay__bar">
    <span class="replay__caption">A result it has already produced: change only the chunk size</span>
    <div class="replay__controls" role="group" aria-label="Metric">
      {Object.keys(series).map((k, i) => <button class="chip" type="button" data-pick={k} aria-pressed={i === 0 ? 'true' : 'false'}>{k}</button>)}
    </div>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Retrieval recall at 1, 5 and 10 for chunk sizes from 1,000 to 8,000 characters">
    {[0, 25, 50, 75, 100].map((v) => (
      <g>
        <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="var(--color-line)" />
        <text x={L - 8} y={y(v) + 4} text-anchor="end" font-size="11">{v}%</text>
      </g>
    ))}
    {sizes.map((s, i) => <text x={x(i)} y={H - 12} text-anchor="middle" font-size="11">{s} chars</text>)}
    {Object.entries(series).map(([k, vals]) => (
      <g data-series={k}>
        <polyline points={vals.map((v, i) => `${x(i)},${y(v)}`).join(' ')} fill="none" stroke-width="2.5" />
        {vals.map((v, i) => (
          <g>
            <circle cx={x(i)} cy={y(v)} r="4.5" />
            <text class="evalr__v" x={x(i)} y={y(v) - 10} text-anchor="middle" font-size="12">{v}%</text>
          </g>
        ))}
        <text class="evalr__k" x={W - R + 8} y={y(vals[3]) + 4} font-size="12">{k}</text>
      </g>
    ))}
  </svg>
  <p class="replay__note" data-say="recall@1">The answer’s passage ranked first peaks at 4k characters, then falls. Bigger chunks contain the answer more often but dilute the signal that ranks it first.</p>
  <p class="replay__note" data-say="recall@5" hidden>Within the top five, bigger keeps winning. The right chunk size depends on how many passages you show the model, which intuition gets wrong.</p>
  <p class="replay__note" data-say="recall@10" hidden>Top ten reaches 89% at 8k. Measured on 510 contracts and 30 expert-annotated cases, with no API key needed.</p>
</div>

<style>
  .evalr svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .evalr [data-series] polyline {
    stroke: var(--color-line);
  }
  .evalr [data-series] circle {
    fill: var(--color-line);
  }
  .evalr [data-series] .evalr__v {
    opacity: 0;
  }
  .evalr [data-series].is-on polyline {
    stroke: var(--color-trace);
  }
  .evalr [data-series].is-on circle {
    fill: var(--color-trace);
  }
  .evalr [data-series].is-on .evalr__v {
    opacity: 1;
    fill: var(--color-ink);
    font-weight: 600;
  }
  .evalr [data-series].is-on .evalr__k {
    fill: var(--color-trace);
    font-weight: 650;
  }
</style>

<script>
  function initEval() {
    document.querySelectorAll<HTMLElement>('[data-replay="eval"]').forEach((root) => {
      const btns = root.querySelectorAll<HTMLButtonElement>('[data-pick]');
      const pick = (k: string) => {
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === k)));
        root.querySelectorAll<SVGGElement>('[data-series]').forEach((g) => {
          g.classList.toggle('is-on', g.dataset.series === k);
          if (g.dataset.series === k) g.parentNode!.appendChild(g);
        });
        root.querySelectorAll<HTMLElement>('[data-say]').forEach((p) => (p.hidden = p.dataset.say !== k));
      };
      btns.forEach((b) => b.addEventListener('click', () => pick(b.dataset.pick!)));
      pick('recall@1');
    });
  }
  initEval();
  document.addEventListener('astro:after-swap', initEval);
</script>
