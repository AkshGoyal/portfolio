---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';

const entries = await getCollection('work');
const projects = entries
  .filter((entry) => entry.data.kind === 'project')
  .sort((a, b) => a.data.order - b.data.order);
const employment = entries.find((entry) => entry.data.kind === 'employment');

const roles = ['AI Engineer', 'Forward Deployed Engineer', 'AI Product'];

// These sit inside the Aspect Ratio entry, directly under the description that
// introduces the work, because each one is meaningless without it — a reader
// who meets "40+ countries" before hearing about a tender tool has no idea
// what is being counted.
const impact = [
  {
    figure: '94%',
    label: 'accuracy reached by the chatbot, once I had an evaluation framework measuring it',
  },
  {
    figure: '40+',
    label: 'countries the vaccine tender tool covers, across 5 vaccines',
  },
  {
    figure: '10',
    label: 'users who validated the chatbot before it was handed over',
  },
];

const highlights = [
  'Owned an HCP persona-simulation chatbot end to end, from a brief with no internal precedent — framed the problem with the client’s marketing team, designed the architecture, shipped it over a local network. Validated by 10 users, then handed to a large consultancy for production build-out.',
  'Architected its multi-agent RAG backend: routing agents directing queries across a hybrid retrieval stack (semantic vector search + BM25).',
  'Built the evaluation framework that took it to 94% accuracy — designed test scenarios and failure paths, then iterated chunking, embedding and search strategy against measured results.',
  'Built a tender guidance tool for the global vaccines bidding team spanning 40+ countries and 5 vaccines, putting pricing and bid-strategy guidance at the point of decision.',
  'Wrote 4 web scrapers turning undocumented conference sites with no API into structured datasets, and ran an end-to-end SQL analysis of vaccine-effectiveness data behind a European surveillance report.',
];

// Every claim here is something a reader can go and check in one of the two
// public repositories, which is the only reason the section earns its space.
const principles = [
  {
    title: 'Measure first, then tune',
    body: 'RAG systems are easy to fiddle with and impossible to improve blind. On the chatbot I wrote the evaluation scenarios and failure paths before touching chunking, embeddings or search strategy — which is the only reason 94% means anything.',
  },
  {
    title: 'Ordinary code by default, the model only where judgment is needed',
    body: 'Plan My Day calls a model at exactly three points; the job assistant at two. Everything around them — ingestion, dedup, storage, ordering — is plain Python I can test without a network.',
  },
  {
    title: 'Constrain the output, then verify it anyway',
    body: 'Every call passes a Pydantic schema, and enumerated fields are Literal types so an invalid value cannot be returned. Then the code checks the result against the database: a task id that matches no real row is dropped before it reaches the screen.',
  },
  {
    title: 'One wrapper, so a change stays small',
    body: 'Every model call goes through a single file. Migrating the job assistant from Anthropic to Gemini touched four files and left the pipelines, CLI and prompts untouched.',
  },
  {
    title: 'Say where the boundary is',
    body: 'The job assistant reads Gmail strictly read-only and never sends anything. Plan My Day has no auth, so it binds to 127.0.0.1 and documents that rather than shipping security theatre. Neither has a hosted demo, for reasons I would rather state than hide.',
  },
];

const contacts = [
  {
    label: 'Email',
    value: 'aksh.iitdelhi@gmail.com',
    href: 'mailto:aksh.iitdelhi@gmail.com',
  },
  {
    label: 'GitHub',
    value: 'github.com/akshgoyal',
    href: 'https://github.com/akshgoyal',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/akshgoyal',
    href: 'https://linkedin.com/in/akshgoyal',
  },
];
---

<BaseLayout
  title="Aksh Goyal — AI Engineer"
  description="I turn messy, real-world problems into working AI tools — from pharma market intelligence to agents that run my own job search."
>
  <div class="mx-auto max-w-3xl px-6 sm:px-8">
    <section class="pt-16 pb-14 sm:pt-20">
      <h1
        class="font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
      >
        Aksh Goyal
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        I turn messy, real-world problems into working AI tools — from pharma
        market intelligence to agents that run my own job search.
      </p>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">
        Fifteen months embedded with the Vaccines Commercial team of a global
        pharmaceutical company, building the RAG systems and internal tools
        their marketing, medical and bidding teams use. IIT Delhi, 2025.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-2">
        <span class="mr-1 text-[0.875rem] text-muted">Looking for roles in</span
        >
        {roles.map((role) => <Tag label={role} />)}
      </div>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="rounded-[3px] bg-accent px-4 py-2.5 font-mono text-[0.8125rem] text-on-accent transition-opacity hover:opacity-88"
          >See what I've built</a
        >
        <a
          href="/resume.pdf"
          class="rounded-[3px] border border-line px-4 py-2.5 font-mono text-[0.8125rem] text-ink transition-colors hover:border-accent hover:text-accent"
          >Resume</a
        >
        <a
          href="mailto:aksh.iitdelhi@gmail.com"
          class="rounded-[3px] border border-line px-4 py-2.5 font-mono text-[0.8125rem] text-ink transition-colors hover:border-accent hover:text-accent"
          >Email me</a
        >
      </div>
    </section>

    <section id="experience" class="scroll-mt-8 border-t border-line py-12">
      <h2
        class="font-display text-[0.9375rem] font-semibold tracking-tight text-muted"
      >
        Experience
      </h2>

      <div class="mt-7" data-reveal>
        <div
          class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1"
        >
          <h3 class="font-display text-lg font-semibold tracking-tight text-ink">
            Analyst — Aspect Ratio
          </h3>
          <p class="font-mono text-[0.75rem] text-muted">Jun 2025 – Aug 2026</p>
        </div>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted">
          AI &amp; strategy consulting. For 15 months I was embedded with the
          Vaccines Commercial team of a global pharmaceutical company — sitting
          with their marketing, medical and global bidding teams, turning briefs
          with no internal precedent into software they use.
        </p>

        <dl class="mt-7 grid gap-px border-y border-line sm:grid-cols-3">
          {
            impact.map((item, index) => (
              <div class="py-5 sm:pr-6" data-reveal data-reveal-index={index}>
                <dt class="font-display text-3xl font-semibold tracking-tight text-ink">
                  {item.figure}
                </dt>
                <dd class="mt-1 max-w-[24ch] text-[0.875rem] leading-snug text-muted">
                  {item.label}
                </dd>
              </div>
            ))
          }
        </dl>

        <ul class="mt-6 max-w-2xl">
          {
            highlights.map((item) => (
              <li class="relative mt-3 pl-6 leading-relaxed text-muted before:absolute before:left-0 before:top-[0.75em] before:h-px before:w-3 before:bg-line">
                {item}
              </li>
            ))
          }
        </ul>

        {
          employment && (
            <p class="mt-6 font-mono text-[0.8125rem]">
              <a
                href={`/work/${employment.id}/`}
                class="text-accent underline underline-offset-4 transition-opacity hover:opacity-70"
              >
                Read how the chatbot was built
              </a>
            </p>
          )
        }
      </div>

      <div class="mt-10 border-t border-line pt-8" data-reveal>
        <div
          class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1"
        >
          <h3 class="font-display text-lg font-semibold tracking-tight text-ink">
            Summer Trainee — Grant Thornton Bharat
          </h3>
          <p class="font-mono text-[0.75rem] text-muted">
            2023 &amp; 2024, public sector consulting
          </p>
        </div>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted">
          Two summers on government engagements: a Power BI dashboard tracking a
          large-scale resource deployment state-wise and designation-wise, and —
          the year before — unifying citizen datasets in Alteryx behind a
          Tableau dashboard covering 15+ schemes, reviewed quarterly by state
          leadership.
        </p>
        <p class="mt-4 font-mono text-[0.8125rem]">
          <a
            href="/about/"
            class="text-accent underline underline-offset-4 transition-opacity hover:opacity-70"
            >More background</a
          >
        </p>
      </div>
    </section>

    <section id="approach" class="scroll-mt-8 border-t border-line py-12">
      <h2
        class="font-display text-[0.9375rem] font-semibold tracking-tight text-muted"
      >
        How I build
      </h2>
      <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">
        Five things I do consistently. Each one is visible in the code of the
        projects below, not just asserted here.
      </p>

      <dl class="mt-7">
        {
          principles.map((principle, index) => (
            <div
              class="border-line py-6 not-first:border-t"
              data-reveal
              data-reveal-index={index}
            >
              <dt class="font-display text-[1.0625rem] font-semibold tracking-tight text-ink">
                {principle.title}
              </dt>
              <dd class="mt-2 max-w-2xl leading-relaxed text-muted">
                {principle.body}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="projects" class="scroll-mt-8 border-t border-line py-12">
      <h2
        class="font-display text-[0.9375rem] font-semibold tracking-tight text-muted"
      >
        Projects
      </h2>
      <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">
        Tools I built for myself, outside work, and still use. Each page covers
        the problem, the architecture, and the decisions that were actually
        hard — and every one of them is open source, so you can check the claims
        against the code.
      </p>

      <ul class="mt-7">
        {
          projects.map((project, index) => (
            <li
              class="border-line not-first:border-t"
              data-reveal
              data-reveal-index={index}
            >
              <div class="-mx-4 px-4 py-7">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                  <h3 class="font-display text-xl font-semibold tracking-tight text-ink">
                    <a
                      href={`/work/${project.id}/`}
                      class="underline-offset-4 transition-colors hover:text-accent hover:underline"
                    >
                      {project.data.title}
                    </a>
                  </h3>
                  <p class="font-mono text-[0.75rem] text-muted">
                    {project.data.period} · {project.data.stack.join(' · ')}
                  </p>
                </div>
                <p class="mt-3 max-w-2xl leading-relaxed text-muted">
                  {project.data.tagline}
                </p>
                <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.8125rem]">
                  <a
                    href={`/work/${project.id}/`}
                    class="text-accent underline underline-offset-4 transition-opacity hover:opacity-70"
                  >
                    Read the case study
                  </a>
                  {project.data.repoUrl && (
                    <a
                      href={project.data.repoUrl}
                      class="text-muted underline underline-offset-4 transition-colors hover:text-accent"
                    >
                      Source on GitHub
                    </a>
                  )}
                  <a
                    href={`/work/${project.id}/#run-it-yourself`}
                    class="text-muted underline underline-offset-4 transition-colors hover:text-accent"
                  >
                    Run it yourself
                  </a>
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 border-t border-line pt-8" data-reveal>
        <h3 class="font-display text-[1.0625rem] font-semibold tracking-tight text-ink">
          Also built
        </h3>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted">
          <span class="text-ink">GEO optimization engine</span> (Jul 2025) —
          rewrites webpages so that language models retrieve and cite them.
          Evaluated against 150+ synthetic LLM queries; citation rate improved
          41%. Not open source, but the evaluation-first pattern is the same one
          I use everywhere else.
        </p>
      </div>
    </section>

    <section id="contact" class="scroll-mt-8 border-t border-line py-12">
      <h2
        class="font-display text-[0.9375rem] font-semibold tracking-tight text-muted"
      >
        Contact
      </h2>
      <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">
        I'm looking for AI Engineer, Forward Deployed Engineer and AI Product
        roles, and I'm open to relocating — in India or internationally. The
        fastest way to reach me is email.
      </p>

      <dl class="mt-7">
        {
          contacts.map((contact, index) => (
            <div
              class="flex flex-wrap items-baseline gap-x-6 gap-y-1 py-2"
              data-reveal
              data-reveal-index={index}
            >
              <dt class="w-20 shrink-0 text-[0.9375rem] text-muted">
                {contact.label}
              </dt>
              <dd class="font-mono text-[0.875rem]">
                <a
                  href={contact.href}
                  class="text-ink underline-offset-4 transition-colors hover:text-accent hover:underline"
                >
                  {contact.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>
