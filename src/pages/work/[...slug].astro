---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('work');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);

const isEmployment = project.data.kind === 'employment';
const backHref = isEmployment ? '/#experience' : '/#projects';
const backLabel = isEmployment ? 'All experience' : 'All projects';
---

<BaseLayout
  title={`${project.data.title} — Aksh Goyal`}
  description={project.data.tagline}
>
  <div class="progress-bar" aria-hidden="true"></div>

  <article class="mx-auto max-w-3xl px-6 sm:px-8">
    <div class="py-10">
      <a
        href={backHref}
        class="font-mono text-[0.8125rem] text-muted underline-offset-4 transition-colors hover:text-accent hover:underline"
        >{backLabel}</a
      >
    </div>

    <header class="border-b border-line pb-10">
      <p class="font-mono text-[0.75rem] text-muted">
        {project.data.period}{project.data.org && ` · ${project.data.org}`}
      </p>
      <h1
        class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
      >
        {project.data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        {project.data.tagline}
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {project.data.topics.map((topic) => <Tag label={topic} />)}
      </div>

      {
        (project.data.repoUrl || project.data.access) && (
          <div class="mt-7 border-t border-line pt-6">
            {project.data.repoUrl && (
              <p class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.8125rem]">
                <a
                  href={project.data.repoUrl}
                  class="text-accent underline underline-offset-4 transition-opacity hover:opacity-70"
                >
                  {project.data.repo}
                </a>
                <a
                  href="#run-it-yourself"
                  class="text-muted underline underline-offset-4 transition-colors hover:text-accent"
                >
                  Run it yourself
                </a>
              </p>
            )}
            {project.data.access && (
              <p
                class:list={[
                  'max-w-2xl text-[0.875rem] leading-relaxed text-muted',
                  project.data.repoUrl && 'mt-3',
                ]}
              >
                {project.data.access}
              </p>
            )}
          </div>
        )
      }
    </header>

    <div class="prose py-12">
      <Content />
    </div>

    <div class="border-t border-line py-10">
      <p class="max-w-2xl leading-relaxed text-muted">
        I'm looking for AI Engineer, Forward Deployed Engineer and AI Product
        roles.
        <a
          class="text-accent underline underline-offset-4 transition-opacity hover:opacity-70"
          href="mailto:aksh.iitdelhi@gmail.com">Email me</a
        > if this is the kind of work you're hiring for.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={backHref}
          class="rounded-[3px] border border-line px-4 py-2.5 font-mono text-[0.8125rem] text-ink transition-colors hover:border-accent hover:text-accent"
          >{backLabel}</a
        >
        <a
          href="/resume.pdf"
          class="rounded-[3px] border border-line px-4 py-2.5 font-mono text-[0.8125rem] text-ink transition-colors hover:border-accent hover:text-accent"
          >Resume</a
        >
      </div>
    </div>
  </article>
</BaseLayout>
