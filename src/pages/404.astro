---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not found — Aksh Goyal"
  description="That page doesn't exist."
>
  <div class="mx-auto max-w-3xl px-6 py-24 sm:px-8 sm:py-32">
    <p class="font-display text-6xl font-semibold tracking-tight text-ink">
      404
    </p>
    <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">
      That page doesn't exist — it may have been moved or renamed.
    </p>
    <p class="mt-8 font-mono text-[0.8125rem]">
      <a
        href="/"
        class="text-accent underline underline-offset-4 transition-opacity hover:opacity-70"
        >Back to the home page</a
      >
    </p>
  </div>
</BaseLayout>
