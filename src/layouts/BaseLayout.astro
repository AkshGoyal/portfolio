---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Only emitted when the site URL is known, since og:image must be absolute —
// a relative or placeholder URL is worse than no card at all.
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }

    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ClientRouter />

    <script is:inline>
      // Runs before first paint: applies the saved theme so a returning
      // visitor never sees a flash of the other one, and arms scroll reveals
      // only when motion is welcome.
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {
          /* private mode or blocked storage — fall back to the system theme */
        }
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('js-reveal');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      /*
       * Scroll reveals and the reading-progress bar share one rAF-throttled
       * scroll handler.
       *
       * Reveals are a position sweep rather than an IntersectionObserver
       * because an observer only fires on a threshold crossing: jump straight
       * to the bottom of the page (End key, a deep link, restored scroll
       * position) and everything skipped over never intersects, so it stays
       * invisible until you scroll back up past it. A sweep reveals anything
       * at or above the fold, which is correct however the visitor got there.
       */
      let pending: HTMLElement[] = [];

      function sweep() {
        if (!pending.length) return;
        const fold = window.innerHeight * 0.92;
        const remaining = [];
        for (const el of pending) {
          if (el.getBoundingClientRect().top < fold) {
            const index = Number(el.dataset.revealIndex ?? 0);
            el.style.setProperty(
              '--reveal-delay',
              `${Math.min(index, 5) * 60}ms`
            );
            el.classList.add('is-visible');
          } else {
            remaining.push(el);
          }
        }
        pending = remaining;
      }

      function updateProgress() {
        const bar = document.querySelector<HTMLElement>('.progress-bar');
        if (!bar) return;
        const scrollable =
          document.documentElement.scrollHeight - window.innerHeight;
        const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
        bar.style.setProperty(
          '--progress',
          String(Math.min(1, Math.max(0, ratio)))
        );
      }

      let ticking = false;

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          sweep();
          updateProgress();
        });
      }

      // `window` survives client-router navigations, so the listeners must
      // only ever be attached once; the elements they touch are re-collected
      // on every page load because the document itself is replaced.
      let wired = false;

      function init() {
        const targets = Array.from(
          document.querySelectorAll<HTMLElement>('[data-reveal]')
        );
        if (document.documentElement.classList.contains('js-reveal')) {
          pending = targets;
          sweep();
        } else {
          // Motion is unwelcome, or the inline head script never ran: the CSS
          // hidden state is inactive, so there is nothing to reveal.
          pending = [];
        }
        updateProgress();

        if (wired) return;
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        wired = true;
      }

      init();
      // The client router swaps the document without a full reload.
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
